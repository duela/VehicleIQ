FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY core/pom.xml core/pom.xml
RUN mvn -q -f core/pom.xml dependency:go-offline
COPY core/src core/src
RUN mvn -q -f core/pom.xml package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/core/target/vehicleiq-core-0.1.0.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java","-jar","/app/app.jar"]

